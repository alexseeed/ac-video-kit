# Server only. Unique secrets per deployment; never reuse across servers.
# Generate each value with: openssl rand -hex 32
# The server refuses to start with 'change-me' or values shorter than 16 characters.
PUBLIC_HOST=video.example.com
VIDEO_KIT_IMAGE_TAG=latest
API_KEYS=change-me
WORKER_TOKEN=change-me
INTERNAL_VIEW_TOKEN=change-me
DISPATCH_ENABLED=1

# Eigenes HMAC-Secret nur auf dem Server; niemals an Plattform/Browser geben.
PREVIEW_SECRET=change-me
